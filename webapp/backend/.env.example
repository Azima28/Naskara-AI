# ============================================================
# PKL Report Generator — contoh environment
# Copy ke .env lalu isi sesuai setup kamu.
# ============================================================

# --- App ---
APP_NAME=PKL Report Generator
DEBUG=true
# Asal origin frontend yang diizinkan (CORS). Untuk dev: alamat Vite.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Local-first pakai SQLite. Ganti ke postgresql+psycopg://user:pass@host/db
# kalau mau naik ke Postgres nanti (model SQLAlchemy sama, cuma connection string).
DATABASE_URL=sqlite:///./pkl_reports.db

# --- Security ---
# Ganti ke string acak panjang untuk produksi (mis. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
SECRET_KEY=ganti-saya-jadi-string-acak-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI provider (9router / OpenAI-compatible) ---
# Asumsi 9router expose endpoint chat OpenAI-compatible.
# AI_BASE_URL = root endpoint router (tanpa /chat/completions).
# AI_MODEL     = nama model yang terdaftar di router.
AI_ENABLED=true
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=local-model
AI_API_KEY=not-needed
AI_TIMEOUT=120
