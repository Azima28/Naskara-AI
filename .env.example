# ==============================================================================
# NASKARA ACADEMIC STUDIO - CLOUDFLARE DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Token Cloudflare Tunnel Anda (Dapatkan dari Cloudflare Zero Trust -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=eyJhSWQiOiI...masukkan_token_tunnel_anda_di_sini...

# Kunci Rahasia JWT Token Auth (Ganti dengan string acak panjang di production)
SECRET_KEY=naskara-prod-secret-key-change-this-in-production

# AI Provider Configuration (Opsional - Jika menggunakan AI Local 9router / OpenCode port 2018)
AI_ENABLED=true
AI_BASE_URL=http://host.docker.internal:2018/v1
AI_MODEL=local-model
AI_API_KEY=not-needed
